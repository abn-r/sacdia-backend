}

// ─────────────────────────────────────────────────────────────────────────────
// MATERIALES MODULE — T1.1 Enums + T1.2 Models
// ─────────────────────────────────────────────────────────────────────────────

enum MaterialOrderEstado {
  en_revision
  aprobada
  pagada
  entregada
  cancelada
}

enum MaterialDisponibilidad {
  pendiente
  disponible
  parcial
  agotado
}

enum MaterialComprobanteStatus {
  pendiente
  aprobado
  rechazado
}

enum MaterialVariantType {
  talla
  color
}

enum MaterialEntrega {
  recoger
  envio
}

model MaterialCategory {
  id             String   @id @default(uuid()) @db.Uuid
  local_field_id Int
  slug           String   @db.VarChar(100)
  label          String   @db.VarChar(200)
  icon           String?  @db.VarChar(100)
  sort_order     Int      @default(0)
  active         Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  local_field local_fields      @relation(fields: [local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  products    MaterialProduct[]

  @@unique([local_field_id, slug], map: "uq_material_categories_lf_slug")
  @@unique([id, local_field_id], map: "uq_material_categories_id_lf")
  @@index([local_field_id, active], map: "idx_material_categories_lf_active")
  @@map("material_categories")
}

model MaterialProduct {
  id                   String   @id @default(uuid()) @db.Uuid
  local_field_id       Int
  sku                  String   @db.VarChar(100)
  title                String   @db.VarChar(200)
  description          String?
  material_category_id String   @db.Uuid
  club_type_id         Int
  price_centavos       Int
  stock                Int      @default(0)
  active               Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  local_field local_fields        @relation(fields: [local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  category    MaterialCategory    @relation(fields: [material_category_id, local_field_id], references: [id, local_field_id], onDelete: Restrict, onUpdate: NoAction)
  club_type   club_types          @relation(fields: [club_type_id], references: [club_type_id], onDelete: Restrict, onUpdate: NoAction)
  variants    MaterialVariant[]
  order_lines MaterialOrderLine[]

  @@unique([local_field_id, sku], map: "uq_material_products_local_field_sku")
  @@index([local_field_id, active, club_type_id, material_category_id], map: "idx_material_products_lf_active_type_cat")
  @@index([local_field_id], map: "idx_material_products_local_field_id")
  @@index([title], map: "idx_material_products_title")
  @@map("material_products")
}

model MaterialVariant {
  id         String              @id @default(uuid()) @db.Uuid
  product_id String              @db.Uuid
  type       MaterialVariantType

  product MaterialProduct         @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options MaterialVariantOption[]

  @@unique([product_id], map: "uq_material_variant_per_product")
  @@map("material_variants")
}

model MaterialVariantOption {
  id         String @id @default(uuid()) @db.Uuid
  variant_id String @db.Uuid
  label      String @db.VarChar(100)
  stock      Int    @default(0)

  variant     MaterialVariant     @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_lines MaterialOrderLine[]

  @@unique([variant_id, label], map: "uq_material_variant_option_label")
  @@map("material_variant_options")
}

model MaterialOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  local_field_id     Int
  folio_referencia   String?             @db.VarChar(12)
  estado             MaterialOrderEstado @default(en_revision)
  club_section_id    Int
  created_by         String              @db.Uuid
  approved_by        String?             @db.Uuid
  validated_by       String?             @db.Uuid
  delivered_by       String?             @db.Uuid
  cancelled_by       String?             @db.Uuid
  subtotal_centavos  Int                 @default(0)
  envio_centavos     Int                 @default(0)
  total_centavos     Int                 @default(0)
  entrega            MaterialEntrega
  notas              String?
  cancel_reason      String?
  refund_pending     Boolean             @default(false)
  // bank config snapshot (denormalized at approval)
  bank_name          String?
  bank_account_clabe String?             @db.VarChar(18)
  account_holder     String?
  pickup_address     String?
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  approved_at        DateTime?           @db.Timestamptz(6)
  paid_at            DateTime?           @db.Timestamptz(6)
  delivered_at       DateTime?           @db.Timestamptz(6)
  cancelled_at       DateTime?           @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  local_field  local_fields          @relation(fields: [local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  club_section club_sections         @relation(fields: [club_section_id], references: [club_section_id], onDelete: Restrict, onUpdate: NoAction)
  creator      users                 @relation("material_order_creator", fields: [created_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  approver     users?                @relation("material_order_approver", fields: [approved_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  validator    users?                @relation("material_order_validator", fields: [validated_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  deliverer    users?                @relation("material_order_deliverer", fields: [delivered_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  canceller    users?                @relation("material_order_canceller", fields: [cancelled_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  lines        MaterialOrderLine[]
  comprobantes MaterialComprobante[]

  @@unique([local_field_id, folio_referencia], map: "uq_material_orders_lf_folio_ref")
  @@index([local_field_id], map: "idx_material_orders_local_field_id")
  @@index([estado, created_at(sort: Desc)], map: "idx_material_orders_estado_created")
  @@index([club_section_id, estado], map: "idx_material_orders_section_estado")
  @@index([created_by, created_at(sort: Desc)], map: "idx_material_orders_created_by")
  @@map("material_orders")
}

model MaterialOrderLine {
  id                  String                 @id @default(uuid()) @db.Uuid
  order_id            String                 @db.Uuid
  product_id          String                 @db.Uuid
  variant_option_id   String?                @db.Uuid
  qty                 Int
  price_centavos      Int
  disponibilidad      MaterialDisponibilidad @default(pendiente)
  qty_disponible      Int?
  line_total_centavos Int                    @default(0)

  order          MaterialOrder          @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        MaterialProduct        @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant_option MaterialVariantOption? @relation(fields: [variant_option_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([order_id, product_id, variant_option_id], map: "uq_material_order_line")
  @@index([order_id], map: "idx_material_order_lines_order")
  @@map("material_order_lines")
}

model MaterialComprobante {
  id                     String                    @id @default(uuid()) @db.Uuid
  order_id               String                    @db.Uuid
  r2_key                 String
  file_name              String
  mime_type              String                    @db.VarChar(100)
  size_bytes             Int
  monto_centavos         Int
  ref_bancaria_declarada String?
  fecha_pago             DateTime?                 @db.Date
  status                 MaterialComprobanteStatus @default(pendiente)
  uploaded_by            String                    @db.Uuid
  validated_by           String?                   @db.Uuid
  reject_reason          String?
  created_at             DateTime                  @default(now()) @db.Timestamptz(6)
  validated_at           DateTime?                 @db.Timestamptz(6)

  order     MaterialOrder @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader  users         @relation("material_comprobante_uploader", fields: [uploaded_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  validator users?        @relation("material_comprobante_validator", fields: [validated_by], references: [user_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([order_id, created_at], map: "idx_material_comprobantes_order_created")
  @@map("material_comprobantes")
}

model MaterialFolioCounter {
  local_field_id Int
  year           Int
  last_folio     Int      @default(0)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  local_field local_fields @relation(fields: [local_field_id], references: [local_field_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([local_field_id, year])
  @@map("material_folio_counters")
}

model MaterialConfig {
  local_field_id         Int      @id
  bank_name              String?
  bank_account_clabe     String?  @db.VarChar(18)
  account_holder         String?
  envio_centavos_default Int      @default(0)
  pickup_address         String?
  delivery_options       Json     @default("[]")
  updated_by             String?  @db.Uuid
  updated_at             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  local_field local_fields @relation(fields: [local_field_id], references: [local_field_id], onDelete: Cascade, onUpdate: NoAction)
  updater     users?       @relation("material_config_updater", fields: [updated_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@map("material_config")
}

model MaterialAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  local_field_id Int
  actor_user_id  String   @db.Uuid
  entity_type    String   @db.VarChar(64)
  entity_id      String   @db.VarChar(64)
  action         String   @db.VarChar(96)
  before_json    Json?
  after_json     Json?
  correlation_id String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  local_field local_fields @relation(fields: [local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  actor       users        @relation("material_audit_actor", fields: [actor_user_id], references: [user_id], onDelete: Restrict, onUpdate: NoAction)

  @@index([local_field_id, created_at(sort: Desc)], map: "idx_material_audit_lf_created")
  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "idx_material_audit_entity_created")
  @@index([correlation_id], map: "idx_material_audit_correlation")
  @@map("material_audit_logs")
}


model camporee_event_rubrics {
  camporee_event_rubric_id Int      @id @default(autoincrement())
  camporee_event_id        Int
  title                    String   @db.VarChar(120)
  description              String?
  max_points               Decimal  @db.Decimal(10, 2)
  display_order            Int      @default(0)
  active                   Boolean  @default(true)
  created_by               String?  @db.Uuid
  modified_by              String?  @db.Uuid
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  modified_at              DateTime @default(now()) @db.Timestamptz(6)

  camporee_event  camporee_events @relation(fields: [camporee_event_id], references: [camporee_event_id], onDelete: Cascade, onUpdate: NoAction)
  creator         users?          @relation("camporee_event_rubric_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier        users?          @relation("camporee_event_rubric_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  submission_items camporee_event_score_submission_items[]

  @@index([camporee_event_id, active, display_order], map: "idx_camporee_event_rubrics_event_active")
}

model camporee_staff_members {
  camporee_staff_member_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_camporee_id        Int?
  union_camporee_id        Int?
  user_id                  String   @db.Uuid
  category                 String   @db.VarChar(30)
  role_label               String?  @db.VarChar(100)
  notes                    String?
  status                   String   @default("active") @db.VarChar(20)
  active                   Boolean  @default(true)
  created_by               String?  @db.Uuid
  modified_by              String?  @db.Uuid
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  modified_at              DateTime @default(now()) @db.Timestamptz(6)

  local_camporee local_camporees? @relation(fields: [local_camporee_id], references: [local_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  union_camporee union_camporees? @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  user           users            @relation("camporee_staff_member_user", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  creator        users?           @relation("camporee_staff_member_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier       users?           @relation("camporee_staff_member_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  event_assignments camporee_event_staff_assignments[]

  @@index([local_camporee_id, active], map: "idx_camporee_staff_local_active")
  @@index([union_camporee_id, active], map: "idx_camporee_staff_union_active")
  @@index([user_id], map: "idx_camporee_staff_user")
}

model camporee_event_staff_assignments {
  camporee_event_staff_assignment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camporee_event_id                  Int
  camporee_staff_member_id           String   @db.Uuid
  assignment_role                    String   @db.VarChar(30)
  title_override                     String?  @db.VarChar(100)
  notes                              String?
  display_order                      Int      @default(0)
  active                             Boolean  @default(true)
  created_by                         String?  @db.Uuid
  modified_by                        String?  @db.Uuid
  created_at                         DateTime @default(now()) @db.Timestamptz(6)
  modified_at                        DateTime @default(now()) @db.Timestamptz(6)

  camporee_event        camporee_events        @relation(fields: [camporee_event_id], references: [camporee_event_id], onDelete: Cascade, onUpdate: NoAction)
  camporee_staff_member camporee_staff_members @relation(fields: [camporee_staff_member_id], references: [camporee_staff_member_id], onDelete: Cascade, onUpdate: NoAction)
  creator               users?                 @relation("camporee_event_staff_assignment_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier              users?                 @relation("camporee_event_staff_assignment_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([camporee_event_id, active, display_order], map: "idx_camporee_event_staff_event")
  @@index([camporee_staff_member_id, active], map: "idx_camporee_event_staff_member")
}

model camporee_judges {
  camporee_judge_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_camporee_id Int?
  union_camporee_id Int?
  user_id           String   @db.Uuid
  status            String   @default("active") @db.VarChar(20)
  notes             String?
  active            Boolean  @default(true)
  created_by        String?  @db.Uuid
  modified_by       String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  modified_at       DateTime @default(now()) @db.Timestamptz(6)

  local_camporee local_camporees? @relation(fields: [local_camporee_id], references: [local_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  union_camporee union_camporees? @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  user           users            @relation("camporee_judge_user", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  creator        users?           @relation("camporee_judge_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier       users?           @relation("camporee_judge_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  assignments    camporee_event_judge_assignments[]

  @@index([local_camporee_id, user_id], map: "idx_camporee_judges_local_user")
  @@index([union_camporee_id, user_id], map: "idx_camporee_judges_union_user")
}

model camporee_event_judge_assignments {
  camporee_event_judge_assignment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camporee_event_id                  Int
  camporee_judge_id                  String   @db.Uuid
  camporee_club_id                   Int?
  club_section_id                    Int
  judge_role                         String   @db.VarChar(20)
  active                             Boolean  @default(true)
  created_by                         String?  @db.Uuid
  modified_by                        String?  @db.Uuid
  created_at                         DateTime @default(now()) @db.Timestamptz(6)
  modified_at                        DateTime @default(now()) @db.Timestamptz(6)

  camporee_event camporee_events @relation(fields: [camporee_event_id], references: [camporee_event_id], onDelete: Cascade, onUpdate: NoAction)
  camporee_judge camporee_judges @relation(fields: [camporee_judge_id], references: [camporee_judge_id], onDelete: Cascade, onUpdate: NoAction)
  camporee_club  camporee_clubs? @relation(fields: [camporee_club_id], references: [camporee_club_id], onDelete: SetNull, onUpdate: NoAction)
  club_section   club_sections   @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  creator        users?          @relation("camporee_event_judge_assignment_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier       users?          @relation("camporee_event_judge_assignment_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  score_submissions camporee_event_score_submissions[]

  @@index([camporee_judge_id, active], map: "idx_camporee_event_judge_assignments_judge")
  @@index([camporee_event_id, club_section_id], map: "idx_camporee_event_judge_assignments_event_section")
}

model camporee_event_score_submissions {
  camporee_event_score_submission_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camporee_event_id                  Int
  camporee_club_id                   Int?
  club_section_id                    Int
  judge_assignment_id                String?  @db.Uuid
  submitted_by                       String   @db.Uuid
  source                             String   @db.VarChar(30)
  status                             String   @default("submitted") @db.VarChar(20)
  score_status                       String   @default("scored") @db.VarChar(20)
  is_no_show                         Boolean  @default(false)
  override_of_submission_id          String?  @db.Uuid
  idempotency_key                    String?  @db.Uuid
  request_hash                       String?  @db.VarChar(64)
  total_awarded_points               Decimal  @default(0) @db.Decimal(10, 2)
  raw_awarded_points                 Decimal  @default(0) @db.Decimal(10, 2)
  minimum_adjustment_points          Decimal  @default(0) @db.Decimal(10, 2)
  total_max_points                   Decimal  @default(0) @db.Decimal(10, 2)
  notes                              String?
  voided_reason                      String?
  created_at                         DateTime @default(now()) @db.Timestamptz(6)
  modified_at                        DateTime @default(now()) @db.Timestamptz(6)

  camporee_event  camporee_events                     @relation(fields: [camporee_event_id], references: [camporee_event_id], onDelete: Cascade, onUpdate: NoAction)
  camporee_club   camporee_clubs?                     @relation(fields: [camporee_club_id], references: [camporee_club_id], onDelete: SetNull, onUpdate: NoAction)
  club_section    club_sections                       @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  judge_assignment camporee_event_judge_assignments?  @relation(fields: [judge_assignment_id], references: [camporee_event_judge_assignment_id], onDelete: SetNull, onUpdate: NoAction)
  submitter       users                               @relation("camporee_score_submission_submitter", fields: [submitted_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  overridden_submission camporee_event_score_submissions? @relation("camporee_score_submission_overrides", fields: [override_of_submission_id], references: [camporee_event_score_submission_id], onDelete: SetNull, onUpdate: NoAction)
  override_submissions camporee_event_score_submissions[] @relation("camporee_score_submission_overrides")
  items           camporee_event_score_submission_items[]
  section_results camporee_event_section_results[]

  @@index([camporee_event_id, club_section_id, created_at], map: "idx_camporee_event_score_submissions_event_section")
  @@index([score_status], map: "idx_camporee_event_score_submissions_score_status")
  @@index([override_of_submission_id], map: "idx_camporee_event_score_submissions_override_of")
}

model camporee_event_score_submission_items {
  camporee_event_score_submission_item_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camporee_event_score_submission_id      String   @db.Uuid
  camporee_event_rubric_id                Int
  awarded_points                          Decimal  @db.Decimal(10, 2)
  notes                                   String?
  created_at                              DateTime @default(now()) @db.Timestamptz(6)

  submission camporee_event_score_submissions @relation(fields: [camporee_event_score_submission_id], references: [camporee_event_score_submission_id], onDelete: Cascade, onUpdate: NoAction)
  rubric     camporee_event_rubrics           @relation(fields: [camporee_event_rubric_id], references: [camporee_event_rubric_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([camporee_event_score_submission_id, camporee_event_rubric_id], map: "uq_camporee_score_submission_item_rubric")
}

model camporee_event_section_results {
  camporee_event_section_result_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camporee_event_id                Int
  camporee_club_id                 Int?
  club_section_id                  Int
  source_submission_id             String   @db.Uuid
  score_status                     String   @default("scored") @db.VarChar(20)
  is_no_show                       Boolean  @default(false)
  total_awarded_points             Decimal  @db.Decimal(10, 2)
  total_max_points                 Decimal  @db.Decimal(10, 2)
  percentage                       Decimal  @db.Decimal(5, 2)
  finalized_by                     String   @db.Uuid
  finalized_at                     DateTime @default(now()) @db.Timestamptz(6)
  active                           Boolean  @default(true)
  created_at                       DateTime @default(now()) @db.Timestamptz(6)
  modified_at                      DateTime @default(now()) @db.Timestamptz(6)

  camporee_event   camporee_events                   @relation(fields: [camporee_event_id], references: [camporee_event_id], onDelete: Cascade, onUpdate: NoAction)
  camporee_club    camporee_clubs?                   @relation(fields: [camporee_club_id], references: [camporee_club_id], onDelete: SetNull, onUpdate: NoAction)
  club_section     club_sections                     @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  source_submission camporee_event_score_submissions @relation(fields: [source_submission_id], references: [camporee_event_score_submission_id], onDelete: NoAction, onUpdate: NoAction)
  finalizer        users                             @relation("camporee_event_section_result_finalizer", fields: [finalized_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([camporee_event_id, club_section_id], map: "idx_camporee_event_section_results_event_section")
  @@index([camporee_event_id, club_section_id, active, score_status], map: "idx_camporee_event_section_results_active_status")
}

model insurance_products {
  insurance_product_id      Int                          @id @default(autoincrement())
  local_field_id            Int
  name                      String                       @db.VarChar(255)
  coverage_scope            insurance_coverage_scope_enum
  validity_mode             insurance_validity_mode_enum
  default_duration_months   Int?
  active                    Boolean                      @default(true)
  created_at                DateTime                     @default(now()) @db.Timestamptz(6)
  modified_at               DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id             String?                      @db.Uuid
  modified_by_id            String?                      @db.Uuid

  local_field   local_fields              @relation(fields: [local_field_id], references: [local_field_id], onDelete: NoAction, onUpdate: NoAction)
  creator       users?                    @relation("insurance_product_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier      users?                    @relation("insurance_product_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  cycle_configs insurance_cycle_configs[]

  @@index([local_field_id, active], map: "idx_insurance_products_local_field_active")
}

model insurance_cycle_configs {
  insurance_cycle_config_id Int                         @id @default(autoincrement())
  insurance_product_id      Int
  local_field_id            Int
  ecclesiastical_year_id    Int
  club_type_id              Int
  unit_cost                 Decimal                     @db.Decimal(10, 2)
  purchase_deadline         DateTime                    @db.Date
  timezone                  String                      @db.VarChar(64)
  active                    Boolean                     @default(true)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  modified_at               DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id             String?                     @db.Uuid
  modified_by_id            String?                     @db.Uuid

  product              insurance_products      @relation(fields: [insurance_product_id], references: [insurance_product_id], onDelete: NoAction, onUpdate: NoAction)
  local_field          local_fields            @relation(fields: [local_field_id], references: [local_field_id], onDelete: NoAction, onUpdate: NoAction)
  ecclesiastical_year  ecclesiastical_years    @relation(fields: [ecclesiastical_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  club_type            club_types              @relation(fields: [club_type_id], references: [club_type_id], onDelete: NoAction, onUpdate: NoAction)
  creator              users?                  @relation("insurance_cycle_config_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier             users?                  @relation("insurance_cycle_config_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  purchases            insurance_purchases[]

  @@unique([insurance_product_id, local_field_id, ecclesiastical_year_id, club_type_id], map: "uq_insurance_cycle_config_effective_scope")
}

model insurance_purchases {
  insurance_purchase_id       Int                                  @id @default(autoincrement())
  insurance_cycle_config_id   Int
  owner_club_id               Int
  purchasing_section_id       Int
  quantity                    Int
  unit_cost_snapshot          Decimal?                             @db.Decimal(10, 2)
  total_amount                Decimal?                             @db.Decimal(12, 2)
  external_reference          String?                              @db.VarChar(255)
  receipt_date                DateTime?                            @db.Date
  applied_deadline            DateTime?                            @db.Date
  classification              insurance_purchase_classification_enum?
  status                      insurance_purchase_status_enum      @default(PENDING_CONFIRMATION)
  submitted_by_id             String                               @db.Uuid
  reviewed_by_id              String?                              @db.Uuid
  reviewed_at                 DateTime?                            @db.Timestamptz(6)
  rejection_reason            String?
  created_at                  DateTime                             @default(now()) @db.Timestamptz(6)
  modified_at                 DateTime                             @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id               String?                              @db.Uuid
  modified_by_id              String?                              @db.Uuid

  cycle_config       insurance_cycle_configs   @relation(fields: [insurance_cycle_config_id], references: [insurance_cycle_config_id], onDelete: NoAction, onUpdate: NoAction)
  owner_club         clubs                     @relation("insurance_purchase_owner_club", fields: [owner_club_id], references: [club_id], onDelete: NoAction, onUpdate: NoAction)
  purchasing_section club_sections             @relation("insurance_purchase_purchasing_section", fields: [purchasing_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  submitter          users                     @relation("insurance_purchase_submitter", fields: [submitted_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  reviewer           users?                    @relation("insurance_purchase_reviewer", fields: [reviewed_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  creator            users?                    @relation("insurance_purchase_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier           users?                    @relation("insurance_purchase_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  coverage_slots     insurance_coverage_slots[]
  evidence_files     insurance_evidence_files[]

  @@index([purchasing_section_id, receipt_date, status], map: "idx_insurance_purchases_section_receipt_status")
}

model insurance_coverage_slots {
  insurance_coverage_slot_id Int                        @id @default(autoincrement())
  insurance_purchase_id      Int
  sequence_number            Int
  owner_club_id              Int
  purchasing_section_id      Int
  current_section_id         Int
  status                     insurance_slot_status_enum @default(AVAILABLE)
  created_at                 DateTime                   @default(now()) @db.Timestamptz(6)
  modified_at                DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id              String?                    @db.Uuid
  modified_by_id             String?                    @db.Uuid

  purchase            insurance_purchases        @relation(fields: [insurance_purchase_id], references: [insurance_purchase_id], onDelete: NoAction, onUpdate: NoAction)
  owner_club          clubs                      @relation("insurance_slot_owner_club", fields: [owner_club_id], references: [club_id], onDelete: NoAction, onUpdate: NoAction)
  purchasing_section  club_sections              @relation("insurance_slot_purchasing_section", fields: [purchasing_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  current_section     club_sections              @relation("insurance_slot_current_section", fields: [current_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  creator             users?                     @relation("insurance_slot_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier            users?                     @relation("insurance_slot_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  movements           insurance_slot_movements[]
  assignments         insurance_assignments[]

  @@unique([insurance_purchase_id, sequence_number], map: "uq_insurance_slot_purchase_sequence")
  @@index([current_section_id, status], map: "idx_insurance_slots_current_section_status")
}

model insurance_slot_movements {
  insurance_slot_movement_id Int                               @id @default(autoincrement())
  insurance_coverage_slot_id Int
  movement_type              insurance_slot_movement_type_enum
  from_section_id            Int?
  to_section_id              Int?
  insurance_assignment_id    Int?
  reason                     String?
  performed_by_id            String                            @db.Uuid
  correlation_id             String?                           @db.Uuid
  created_at                 DateTime                          @default(now()) @db.Timestamptz(6)

  coverage_slot  insurance_coverage_slots @relation(fields: [insurance_coverage_slot_id], references: [insurance_coverage_slot_id], onDelete: NoAction, onUpdate: NoAction)
  from_section   club_sections?           @relation("insurance_slot_movement_from_section", fields: [from_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  to_section     club_sections?           @relation("insurance_slot_movement_to_section", fields: [to_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  assignment     insurance_assignments?   @relation(fields: [insurance_assignment_id], references: [insurance_assignment_id], onDelete: NoAction, onUpdate: NoAction)
  performer      users                     @relation("insurance_slot_movement_performer", fields: [performed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([insurance_coverage_slot_id, created_at], map: "idx_insurance_slot_movements_slot_created")
}

model insurance_assignments {
  insurance_assignment_id          Int                              @id @default(autoincrement())
  insurance_coverage_slot_id       Int
  subject_type                     insurance_assignment_subject_enum
  user_id                          String?                          @db.Uuid
  event_external_participant_id    Int?
  valid_from                       DateTime                         @db.Date
  valid_until                      DateTime                         @db.Date
  status                           insurance_assignment_status_enum @default(PENDING_CONFIRMATION)
  release_reason                   String?
  assigned_by_id                   String                           @db.Uuid
  confirmed_by_id                  String?                          @db.Uuid
  confirmed_at                     DateTime?                        @db.Timestamptz(6)
  created_at                       DateTime                         @default(now()) @db.Timestamptz(6)
  modified_at                      DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id                    String?                          @db.Uuid
  modified_by_id                   String?                          @db.Uuid

  coverage_slot              insurance_coverage_slots       @relation(fields: [insurance_coverage_slot_id], references: [insurance_coverage_slot_id], onDelete: NoAction, onUpdate: NoAction)
  user_subject               users?                         @relation("insurance_assignment_user_subject", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  event_external_participant camporee_external_participants? @relation(fields: [event_external_participant_id], references: [camporee_external_participant_id], onDelete: NoAction, onUpdate: NoAction)
  assigner                   users                          @relation("insurance_assignment_assigner", fields: [assigned_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  confirmer                  users?                         @relation("insurance_assignment_confirmer", fields: [confirmed_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  creator                    users?                         @relation("insurance_assignment_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier                   users?                         @relation("insurance_assignment_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  movements                  insurance_slot_movements[]
  evidence_files             insurance_evidence_files[]

  @@index([user_id, status, valid_until], map: "idx_insurance_assignments_user_status_until")
}

model insurance_evidence_files {
  insurance_evidence_file_id Int                          @id @default(autoincrement())
  insurance_purchase_id      Int?
  insurance_assignment_id    Int?
  evidence_type              insurance_evidence_type_enum
  file_key                   String                       @db.VarChar(500)
  file_name                  String                       @db.VarChar(255)
  mime_type                  String                       @db.VarChar(100)
  file_size                  Int
  external_reference         String?                      @db.VarChar(255)
  receipt_date               DateTime?                    @db.Date
  uploaded_by_id             String                       @db.Uuid
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  modified_at                DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id              String?                      @db.Uuid
  modified_by_id             String?                      @db.Uuid

  purchase    insurance_purchases?   @relation(fields: [insurance_purchase_id], references: [insurance_purchase_id], onDelete: NoAction, onUpdate: NoAction)
  assignment  insurance_assignments? @relation(fields: [insurance_assignment_id], references: [insurance_assignment_id], onDelete: NoAction, onUpdate: NoAction)
  uploader    users                  @relation("insurance_evidence_uploader", fields: [uploaded_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  creator     users?                 @relation("insurance_evidence_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier    users?                 @relation("insurance_evidence_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
}

model camporee_external_participants {
  camporee_external_participant_id Int       @id @default(autoincrement())
  local_camporee_id                Int?
  union_camporee_id                Int?
  full_name                        String    @db.VarChar(255)
  role_type                        String    @db.VarChar(50)
  role_description                 String?   @db.VarChar(500)
  active                           Boolean   @default(true)
  created_at                       DateTime  @default(now()) @db.Timestamptz(6)
  modified_at                      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  created_by_id                    String?   @db.Uuid
  modified_by_id                   String?   @db.Uuid

  local_camporee  local_camporees?       @relation(fields: [local_camporee_id], references: [local_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  union_camporee  union_camporees?       @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  creator         users?                 @relation("camporee_external_participant_creator", fields: [created_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier        users?                 @relation("camporee_external_participant_modifier", fields: [modified_by_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  assignments     insurance_assignments[]

  @@index([local_camporee_id, active], map: "idx_camporee_external_participants_local_active")
  @@index([union_camporee_id, active], map: "idx_camporee_external_participants_union_active")
}
