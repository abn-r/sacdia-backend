// ========================================
// ANNUAL FOLDERS (Phase 5)
// ========================================

model folder_templates {
  folder_template_id     String                      @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  name                   String                      @db.VarChar(200)
  club_type_id           Int
  ecclesiastical_year_id Int
  owner_union_id         Int?
  owner_local_field_id   Int?
  active                 Boolean                     @default(false)
  status                 folder_template_status_enum @default(DRAFT)
  minimum_points         Int                         @default(0)
  closing_date           DateTime?                   @db.Timestamptz(6)
  created_at             DateTime                    @default(now()) @db.Timestamptz(6)
  modified_at            DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  club_type           club_types                 @relation(fields: [club_type_id], references: [club_type_id], onDelete: NoAction, onUpdate: NoAction)
  ecclesiastical_year ecclesiastical_years       @relation(fields: [ecclesiastical_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  owner_union         unions?                    @relation(fields: [owner_union_id], references: [union_id], onDelete: Restrict, onUpdate: NoAction)
  owner_local_field   local_fields?              @relation(fields: [owner_local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  sections            folder_template_sections[]
  annual_folders      annual_folders[]

  // @@unique([club_type_id, ecclesiastical_year_id]) — removed: replaced by 2 partial unique indexes
  // (Prisma 7 DSL cannot model partial uniques; they are declared in migration SQL)
  @@index([club_type_id], map: "idx_folder_templates_club_type")
  @@index([ecclesiastical_year_id], map: "idx_folder_templates_year")
  @@index([owner_union_id], map: "idx_folder_templates_owner_union")
  @@index([owner_local_field_id], map: "idx_folder_templates_owner_local_field")
  @@index([status], map: "idx_folder_templates_status")
}

model folder_template_sections {
  section_id         String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  folder_template_id String   @db.Uuid
  name               String   @db.VarChar(200)
  description        String?
  order              Int
  required           Boolean  @default(true)
  max_points         Int      @default(0)
  minimum_points     Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  modified_at        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  folder_template     folder_templates                    @relation(fields: [folder_template_id], references: [folder_template_id], onDelete: Cascade, onUpdate: NoAction)
  evidences           annual_folder_evidences[]
  evaluations         annual_folder_section_evaluations[]
  section_submissions annual_folder_section_submissions[]

  @@index([folder_template_id], map: "idx_folder_template_sections_template")
}

model annual_folders {
  annual_folder_id            String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  club_enrollment_id          String    @db.Uuid
  folder_template_id          String    @db.Uuid
  hierarchy_context_id        String?   @db.Uuid
  local_camporee_id           Int?
  union_camporee_id           Int?
  requires_union_confirmation Boolean   @default(false)
  /// Status values: "open", "submitted", "under_evaluation", "evaluated", "closed"
  status                      String    @default("open") @db.VarChar(20)
  submitted_at                DateTime? @db.Timestamptz(6)
  closed_at                   DateTime? @db.Timestamptz(6)
  total_earned_points         Int       @default(0)
  total_max_points            Int       @default(0)
  progress_percentage         Float     @default(0)
  evaluated_at                DateTime? @db.Timestamptz(6)
  created_at                  DateTime  @default(now()) @db.Timestamptz(6)
  modified_at                 DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  club_enrollment     club_enrollments                    @relation(fields: [club_enrollment_id], references: [club_enrollment_id], onDelete: NoAction, onUpdate: NoAction)
  folder_template     folder_templates                    @relation(fields: [folder_template_id], references: [folder_template_id], onDelete: NoAction, onUpdate: NoAction)
  hierarchy_context   hierarchy_contexts?                 @relation(fields: [hierarchy_context_id], references: [hierarchy_context_id], onDelete: SetNull, onUpdate: NoAction)
  local_camporee      local_camporees?                    @relation(fields: [local_camporee_id], references: [local_camporee_id], onDelete: NoAction, onUpdate: NoAction)
  union_camporee      union_camporees?                    @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: NoAction, onUpdate: NoAction)
  evidences           annual_folder_evidences[]
  evaluations         annual_folder_section_evaluations[]
  section_submissions annual_folder_section_submissions[]

  @@unique([club_enrollment_id])
  @@index([folder_template_id], map: "idx_annual_folders_template")
  @@index([hierarchy_context_id], map: "idx_annual_folders_hierarchy_context")
  @@index([local_camporee_id], map: "idx_annual_folders_local_camporee")
  @@index([union_camporee_id], map: "idx_annual_folders_union_camporee")
}

model annual_folder_evidences {
  evidence_id       String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  annual_folder_id  String    @db.Uuid
  section_id        String    @db.Uuid
  file_url          String
  file_name         String    @db.VarChar(255)
  uploaded_by       String    @db.Uuid
  notes             String?
  reviewer_note     String?
  reviewer_noted_by String?   @db.Uuid
  reviewer_noted_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  modified_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  annual_folder annual_folders           @relation(fields: [annual_folder_id], references: [annual_folder_id], onDelete: Cascade, onUpdate: NoAction)
  section       folder_template_sections @relation(fields: [section_id], references: [section_id], onDelete: NoAction, onUpdate: NoAction)
  uploader      users                    @relation("annual_folder_evidences_uploader", fields: [uploaded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  reviewer      users?                   @relation("annual_folder_evidences_reviewer", fields: [reviewer_noted_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([annual_folder_id], map: "idx_annual_folder_evidences_folder")
  @@index([section_id], map: "idx_annual_folder_evidences_section")
  @@index([uploaded_by], map: "idx_annual_folder_evidences_uploader")
}

// ========================================
// ANNUAL FOLDERS SCORING (Phase 5.1)
// ========================================

model annual_folder_section_evaluations {
  evaluation_id     String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  annual_folder_id  String                            @db.Uuid
  section_id        String                            @db.Uuid
  earned_points     Int                               @default(0)
  max_points        Int                               @default(0)
  notes             String?
  lf_approved_by    String?                           @db.Uuid
  lf_approved_at    DateTime?                         @db.Timestamptz(6)
  union_approved_by String?                           @db.Uuid
  union_approved_at DateTime?                         @db.Timestamptz(6)
  union_decision    union_evaluation_decision_enum?
  status            annual_folder_section_status_enum @default(PENDING)
  created_at        DateTime                          @default(now()) @db.Timestamptz(6)
  modified_at       DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)

  annual_folder  annual_folders           @relation(fields: [annual_folder_id], references: [annual_folder_id], onDelete: Cascade, onUpdate: NoAction)
  section        folder_template_sections @relation(fields: [section_id], references: [section_id], onDelete: NoAction, onUpdate: NoAction)
  lf_approver    users?                   @relation("evaluation_lf_approver", fields: [lf_approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  union_approver users?                   @relation("evaluation_union_approver", fields: [union_approved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([annual_folder_id, section_id])
  @@index([annual_folder_id], map: "idx_annual_folder_section_evaluations_folder")
  @@index([section_id], map: "idx_annual_folder_section_evaluations_section")
  @@index([lf_approved_by], map: "idx_annual_folder_section_evaluations_lf_approver")
  @@index([status], map: "idx_annual_folder_section_evaluations_status")
  @@map("annual_folder_section_evaluations")
}

// ========================================
// ANNUAL FOLDER SECTION SUBMISSIONS (Phase 5.x)
// Per-section submission tracking — club users submit per section;
// coordinators/admins submit the whole folder.
// ========================================

model annual_folder_section_submissions {
  section_submission_id String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  annual_folder_id      String   @db.Uuid
  section_id            String   @db.Uuid
  submitted_by          String   @db.Uuid
  submitted_at          DateTime @default(now()) @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  modified_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  annual_folder annual_folders           @relation(fields: [annual_folder_id], references: [annual_folder_id], onDelete: Cascade, onUpdate: NoAction)
  section       folder_template_sections @relation(fields: [section_id], references: [section_id], onDelete: NoAction, onUpdate: NoAction)
