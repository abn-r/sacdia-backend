  @@index([union_id, active], map: "camporee_venues_union_idx")
  @@index([local_field_id, active], map: "camporee_venues_local_field_idx")
  @@index([scope, active], map: "camporee_venues_scope_idx")
}

model camporee_event_schedule_blocks {
