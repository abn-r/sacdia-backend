generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  audit_log_id       BigInt    @id @default(autoincrement())
  entity_type        String    @db.VarChar(50)
  entity_id          String    @db.VarChar(64)
  action             String    @db.VarChar(64)
  club_id            Int?
  actor_user_id      String?   @db.Uuid
  summary            String?   @db.VarChar(500)
  changes            Json?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  event_key          String?   @unique(map: "audit_logs_event_key_key") @db.VarChar(160)
  actor_kind         String    @default("user") @db.VarChar(24)
  actor_role_name    String?   @db.VarChar(64)
  actor_scope        Json?
  target_user_id     String?   @db.Uuid
  target_scope       Json?
  effective_at       DateTime? @db.Timestamptz(6)
  correlation_id     String?   @db.Uuid
  idempotency_key    String?   @db.VarChar(128)
  result             String    @default("succeeded") @db.VarChar(32)

  clubs clubs? @relation(fields: [club_id], references: [club_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([club_id, created_at(sort: Desc)], map: "idx_audit_logs_club_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([actor_user_id, created_at(sort: Desc)], map: "idx_audit_logs_actor_created")
  @@index([target_user_id, created_at(sort: Desc)], map: "idx_audit_logs_target_created")
  @@index([action, created_at(sort: Desc)], map: "idx_audit_logs_action_created")
  @@index([correlation_id], map: "idx_audit_logs_correlation_id")
}

model activities {
  activity_id        Int                  @id @default(autoincrement())
  name               String               @db.VarChar(80)
  description        String?
  club_type_id       Int
  active             Boolean              @default(false)
  lat                Float
  long               Float
  activity_time      String               @default("09:00") @db.VarChar(10)
  activity_date      DateTime?            @db.Date
  activity_end_date  DateTime?            @db.Date
  activity_place     String               @default("place")
  image              String
  platform           Int                  @default(0)
  link_meet          String?
  additional_data    String?
  attendees          Json?                @db.Json
  classes            Json?                @db.Json
  reminder_sent      Boolean              @default(false)
  created_by         String               @db.Uuid
  created_at         DateTime?            @db.Timestamptz(6)
  modified_at        DateTime?            @db.Timestamptz(6)
  activity_type_id   Int
  club_section_id    Int?
  is_joint           Boolean              @default(false)
  activity_types     activity_types       @relation(fields: [activity_type_id], references: [activity_type_id], onDelete: NoAction, onUpdate: NoAction)
  club_sections      club_sections?       @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  club_types         club_types           @relation(fields: [club_type_id], references: [club_type_id], onDelete: NoAction, onUpdate: NoAction)
  users              users                @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  activity_instances activity_instances[]

  @@index([activity_type_id], map: "idx_activities_activity_type_id")
  @@index([club_section_id], map: "idx_activities_club_section_id")
  @@index([active, activity_type_id], map: "idx_activities_active_type")
}

model activity_types {
  activity_type_id Int                           @id @default(autoincrement())
  code             String                        @unique @db.VarChar(50)
  name             String                        @unique @db.VarChar(100)
  description      String?
  active           Boolean                       @default(true)
  created_at       DateTime?                     @default(now()) @db.Timestamptz(6)
  modified_at      DateTime?                     @default(now()) @db.Timestamptz(6)
  activities       activities[]
  translations     activity_types_translations[]
}

model activity_instances {
  activity_instance_id Int            @id @default(autoincrement())
  activity_id          Int
  active               Boolean        @default(true)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  modified_at          DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  club_section_id      Int?
  activities           activities     @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade, onUpdate: NoAction)
  club_sections        club_sections? @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([activity_id, club_section_id], map: "activity_instances_unique_instance_per_activity")
  @@index([activity_id], map: "idx_activity_instances_activity")
  @@index([club_section_id], map: "idx_activity_instances_club_section_id")
  @@index([club_section_id, active], map: "idx_activity_instances_section_active")
}

model folder_assignments {
  folder_assignment_id Int            @id @default(autoincrement())
  folder_id            Int?
  active               Boolean        @default(true)
  assignment_date      DateTime?      @default(now()) @db.Timestamptz(6)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  modified_at          DateTime?      @default(now()) @db.Timestamptz(6)
  user_id              String?        @db.Uuid
  completion_date      DateTime?      @db.Timestamptz(6)
  progress_percentage  Float?         @default(0)
  status               String?        @default("IN_PROGRESS")
  total_points         Int?           @default(0)
  club_section_id      Int?
  users                users?         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_assignments_folders_users_user_id")
  club_sections        club_sections? @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  folders              folders?       @relation(fields: [folder_id], references: [folder_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([club_section_id], map: "idx_folder_assignments_club_section_id")
}

model camporee_clubs {
  camporee_club_id  Int              @id @default(autoincrement())
  camporee_id       Int?
  union_camporee_id Int?
  camporee_type     String           @db.VarChar(50)
  club_id           Int?
  local_field_id    Int?
  status            String           @default("registered") @db.VarChar(20)
  registered_by     String?          @db.Uuid
  active            Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  modified_at       DateTime         @default(now()) @db.Timestamptz(6)
  club_section_id   Int?
  rejection_reason  String?
  approved_by       String?          @db.Uuid
  rejected_by       String?          @db.Uuid
  local_camporees   local_camporees? @relation(fields: [camporee_id], references: [local_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  union_camporees   union_camporees? @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  club_sections     club_sections?   @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)
  local_fields      local_fields?    @relation(fields: [local_field_id], references: [local_field_id], onDelete: Cascade, onUpdate: NoAction)
  registrar         users?           @relation("camporee_clubs_registered_by", fields: [registered_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  score_judge_assignments camporee_event_judge_assignments[]
  score_submissions       camporee_event_score_submissions[]
  score_section_results   camporee_event_section_results[]
  schedule_block_assignments camporee_event_schedule_block_assignments[]
  members                 camporee_members[]

  // Partial unique indexes `uq_camporee_clubs_active_local_section` and
  // `uq_camporee_clubs_active_union_section` live in migration SQL/DB because
  // Prisma cannot model partial unique indexes.
  @@index([club_section_id], map: "idx_camporee_clubs_club_section_id")
  @@index([union_camporee_id], map: "idx_camporee_clubs_union_camporee_id")

}

model camporee_members {
  camporee_member_id Int                 @id @default(autoincrement())
  camporee_club_id   Int?
  camporee_id        Int?
  union_camporee_id  Int?
  camporee_type      String              @db.VarChar(50)
  user_id            String              @db.Uuid
  club_name          String?             @db.VarChar(255)
  local_field_id     Int?
  insurance_verified Boolean             @default(false)
  insurance_id       Int?
  active             Boolean             @default(true)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  modified_at        DateTime            @default(now()) @db.Timestamptz(6)
  status             String              @default("registered") @db.VarChar(20)
  rejection_reason   String?
  approved_by        String?             @db.Uuid
  rejected_by        String?             @db.Uuid
  camporee_club      camporee_clubs?     @relation(fields: [camporee_club_id], references: [camporee_club_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camporee_members_camporee_club")
  local_camporees    local_camporees?    @relation(fields: [camporee_id], references: [local_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  union_camporees    union_camporees?    @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  insurance          member_insurances?  @relation(fields: [insurance_id], references: [insurance_id], onDelete: NoAction, onUpdate: NoAction)
  local_fields       local_fields?       @relation(fields: [local_field_id], references: [local_field_id], onDelete: Cascade, onUpdate: NoAction)
  users              users               @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  camporee_payments  camporee_payments[]

  @@index([camporee_club_id], map: "idx_camporee_members_camporee_club_id")
  @@index([union_camporee_id], map: "idx_camporee_members_union_camporee_id")
  @@index([camporee_id], map: "idx_camporee_members_camporee_id")
  @@index([user_id], map: "idx_camporee_members_user_id")
  @@index([camporee_id, active], map: "idx_camporee_members_camporee_active")
  @@index([status], map: "idx_camporee_members_status")
}

model churches {
  church_id                  Int                          @id @default(autoincrement())
  name                       String                       @db.VarChar(50)
  active                     Boolean                      @default(true)
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  modified_at                DateTime?                    @default(now()) @db.Timestamptz(6)
  districlub_type_id         Int
  districts                  districts                    @relation(fields: [districlub_type_id], references: [districlub_type_id], onDelete: NoAction, onUpdate: NoAction)
  clubs                      clubs[]
  church_district_history                 church_district_history[]                 @relation("church_district_history_church")
  club_institutional_history              club_institutional_history[]              @relation("club_institutional_history_church")
  hierarchy_contexts                      hierarchy_contexts[]                      @relation("hierarchy_contexts_church")
  institutional_name_versions             institutional_name_versions[]             @relation("institutional_name_versions_church")
  institutional_reorganization_participants institutional_reorganization_participants[] @relation("institutional_reorg_participants_church")
  translations                            churches_translations[]
}

model churches_translations {
  id         Int       @id @default(autoincrement())
  church_id  Int
  locale     String    @db.VarChar(10)
  name       String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  churches   churches  @relation(fields: [church_id], references: [church_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([church_id, locale], name: "churches_translations_unique_locale", map: "churches_translations_unique_locale")
  @@index([locale])
  @@index([church_id])
}

model class_module_progress {
  module_progress_id Int          @id @default(autoincrement())
  user_id            String       @db.Uuid
  class_id           Int
  module_id          Int
  score              Float
  active             Boolean      @default(true)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  modified_at        DateTime     @default(now()) @db.Timestamptz(6)
  enrollment_id      Int?
  classes            classes      @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  enrollments        enrollments? @relation(fields: [enrollment_id], references: [enrollment_id], onDelete: NoAction, onUpdate: NoAction)
  users              users        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, class_id, module_id])
}

model class_modules {
  module_id      Int                          @id @default(autoincrement())
  name           String                       @db.VarChar(255)
  description    String?
  class_id       Int
  active         Boolean
  created_at     DateTime                     @default(now()) @db.Timestamptz(6)
  modified_at    DateTime                     @default(now()) @db.Timestamptz(6)
  classes        classes                      @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  class_sections class_sections[]
  translations   class_modules_translations[]

  @@unique([name, class_id])
}

model class_modules_translations {
  id            Int           @id @default(autoincrement())
  module_id     Int
  locale        String        @db.VarChar(10)
  name          String?       @db.VarChar(255)
  description   String?
  created_at    DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?     @default(now()) @db.Timestamptz(6)
  class_modules class_modules @relation(fields: [module_id], references: [module_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([module_id, locale])
  @@index([locale])
  @@index([module_id])
}

model class_section_progress {
  section_progress_id Int                      @id @default(autoincrement())
  user_id             String                   @db.Uuid
  class_id            Int
  module_id           Int
  section_id          Int
  score               Float
  evidences           Json?
  active              Boolean                  @default(true)
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  modified_at         DateTime                 @default(now()) @db.Timestamptz(6)
  enrollment_id       Int?
  status              evidence_validation_enum @default(PENDING)
  submitted_by_id     String?                  @db.Uuid
  submitted_at        DateTime?                @db.Timestamptz(6)
  validated_by_id     String?                  @db.Uuid
  validated_at        DateTime?                @db.Timestamptz(6)
  rejection_reason    String?
  classes             classes                  @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  enrollments         enrollments?             @relation(fields: [enrollment_id], references: [enrollment_id], onDelete: NoAction, onUpdate: NoAction)
  users               users                    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  submitted_by        users?                   @relation("section_progress_submitted_by", fields: [submitted_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  validated_by_user   users?                   @relation("section_progress_validated_by", fields: [validated_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  evidence_files      evidence_files[]

  @@unique([user_id, class_id, module_id, section_id])
  @@index([enrollment_id], map: "idx_class_section_progress_enrollment_id")
}

model class_sections {
  section_id               Int                          @id @default(autoincrement())
  name                     String                       @db.VarChar(255)
  description              String?
  module_id                Int
  requirement_track         class_requirement_track_enum @default(BASIC)
  required_for_investiture  Boolean                      @default(true)
  display_order            Int                          @default(0)
  owner_division_id        Int?
  owner_union_id           Int?
  owner_local_field_id     Int?
  available_from_year_id   Int?
  available_until_year_id  Int?
  active                   Boolean
  created_at               DateTime                     @default(now()) @db.Timestamptz(6)
  modified_at              DateTime                     @default(now()) @db.Timestamptz(6)
  class_modules            class_modules                @relation(fields: [module_id], references: [module_id], onDelete: NoAction, onUpdate: NoAction)
  owner_division           divisions?                   @relation("class_sections_owner_division", fields: [owner_division_id], references: [division_id], onDelete: NoAction, onUpdate: NoAction)
  owner_union              unions?                      @relation("class_sections_owner_union", fields: [owner_union_id], references: [union_id], onDelete: NoAction, onUpdate: NoAction)
  owner_local_field        local_fields?                @relation("class_sections_owner_local_field", fields: [owner_local_field_id], references: [local_field_id], onDelete: NoAction, onUpdate: NoAction)
  available_from_year      ecclesiastical_years?        @relation("class_sections_available_from_year", fields: [available_from_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  available_until_year     ecclesiastical_years?        @relation("class_sections_available_until_year", fields: [available_until_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  translations             class_sections_translations[]

  @@unique([name, module_id])
  @@index([requirement_track], map: "idx_class_sections_requirement_track")
  @@index([module_id, requirement_track], map: "idx_class_sections_module_requirement_track")
  @@index([owner_division_id], map: "idx_class_sections_owner_division_id")
  @@index([owner_union_id], map: "idx_class_sections_owner_union_id")
  @@index([owner_local_field_id], map: "idx_class_sections_owner_local_field_id")
  @@index([available_from_year_id], map: "idx_class_sections_available_from_year_id")
  @@index([available_until_year_id], map: "idx_class_sections_available_until_year_id")
}

model class_sections_translations {
  id             Int            @id @default(autoincrement())
  section_id     Int
  locale         String         @db.VarChar(10)
  name           String?        @db.VarChar(255)
  description    String?
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @default(now()) @db.Timestamptz(6)
  class_sections class_sections @relation(fields: [section_id], references: [section_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([section_id, locale])
  @@index([locale])
  @@index([section_id])
}

model classes {
  class_id                      Int                             @id @default(autoincrement())
  name                          String                          @unique @db.VarChar(255)
  description                   String?
  active                        Boolean
  club_type_id                  Int
  minimum_age                   Int
  requires_invested_gm          Boolean                         @default(false)
  advanced_enabled              Boolean                         @default(false)
  display_order                 Int                             @default(0)
  asset_code                    String?                         @unique(map: "classes_asset_code_key") @db.VarChar(10)
  available_from_year_id        Int?
  available_until_year_id       Int?
  min_duration_years            Int                             @default(1)
  max_duration_years            Int                             @default(1)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  modified_at                   DateTime                        @default(now()) @db.Timestamptz(6)
  material_url                  String?                         @db.VarChar
  class_module_progress         class_module_progress[]
  class_counselor_assignments   class_counselor_assignments[]
  class_modules                 class_modules[]
  class_section_progress        class_section_progress[]
  certificate_bulk_import_items certificate_bulk_import_items[]
  club_types                    club_types                      @relation(fields: [club_type_id], references: [club_type_id], onDelete: NoAction, onUpdate: NoAction)
  available_from_year           ecclesiastical_years?           @relation("classes_available_from_year", fields: [available_from_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  available_until_year          ecclesiastical_years?           @relation("classes_available_until_year", fields: [available_until_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  class_honors                  class_honors[]
  enrollments                   enrollments[]
  translations                  classes_translations[]

  @@index([available_from_year_id], map: "idx_classes_available_from_year")
  @@index([available_until_year_id], map: "idx_classes_available_until_year")
}

model certificate_bulk_import_batches {
  batch_id        String                                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String                                    @db.Uuid
  local_field_id  Int?
  status          certificate_bulk_import_batch_status_enum @default(DRAFT)
  raw_ocr_payload Json?
  submitted_at    DateTime?                                 @db.Timestamptz(6)
  reviewed_at     DateTime?                                 @db.Timestamptz(6)
  active          Boolean                                   @default(true)
  created_at      DateTime                                  @default(now()) @db.Timestamptz(6)
  modified_at     DateTime                                  @default(now()) @updatedAt @db.Timestamptz(6)

  user        users                                 @relation("certificate_import_batch_user", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  local_field local_fields?                         @relation(fields: [local_field_id], references: [local_field_id], onDelete: NoAction, onUpdate: NoAction)
  items       certificate_bulk_import_items[]
  files       certificate_bulk_import_files[]
  events      certificate_bulk_import_item_events[]

  @@index([user_id, status], map: "idx_certificate_bulk_batches_user_status")
  @@index([local_field_id, status], map: "idx_certificate_bulk_batches_lf_status")
  @@index([status, submitted_at], map: "idx_certificate_bulk_batches_status_submitted")
}

model certificate_bulk_import_items {
  item_id             String                                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id            String                                            @db.Uuid
  item_type           certificate_bulk_import_item_type_enum
  honor_id            Int?
  class_id            Int?
  detected_name       String?                                           @db.VarChar(255)
  detected_date       DateTime?                                         @db.Date
  completed_at        DateTime?                                         @db.Date
  ocr_confidence      Float?
  field_confidence    Json?
  status              certificate_bulk_import_item_status_enum          @default(NEEDS_REVIEW)
  rejection_reason    String?
  reviewed_by_id      String?                                           @db.Uuid
  reviewed_at         DateTime?                                         @db.Timestamptz(6)
  applied_entity_type certificate_bulk_import_applied_entity_type_enum?
  applied_entity_id   Int?
  active              Boolean                                           @default(true)
  created_at          DateTime                                          @default(now()) @db.Timestamptz(6)
  modified_at         DateTime                                          @default(now()) @updatedAt @db.Timestamptz(6)

  batch       certificate_bulk_import_batches       @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade, onUpdate: NoAction)
  honor       honors?                               @relation(fields: [honor_id], references: [honor_id], onDelete: NoAction, onUpdate: NoAction)
  class       classes?                              @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  reviewed_by users?                                @relation("certificate_import_item_reviewer", fields: [reviewed_by_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  events      certificate_bulk_import_item_events[]

  @@index([batch_id], map: "idx_certificate_bulk_items_batch")
  @@index([status], map: "idx_certificate_bulk_items_status")
  @@index([honor_id], map: "idx_certificate_bulk_items_honor")
  @@index([class_id], map: "idx_certificate_bulk_items_class")
  @@index([applied_entity_type, applied_entity_id], map: "idx_certificate_bulk_items_applied_entity")
}

model certificate_bulk_import_files {
  file_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id       String   @db.Uuid
  file_url       String   @db.VarChar(500)
  file_name      String   @db.VarChar(255)
  file_type      String   @db.VarChar(50)
  uploaded_by_id String   @db.Uuid
  ocr_raw_text   String?
  active         Boolean  @default(true)
  uploaded_at    DateTime @default(now()) @db.Timestamptz(6)

  batch       certificate_bulk_import_batches @relation(fields: [batch_id], references: [batch_id], onDelete: Cascade, onUpdate: NoAction)
