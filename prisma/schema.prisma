model authorization_context_versions {
  user_id     String   @id @db.Uuid
  version     BigInt   @default(0)
  modified_at DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("authorization_context_versions")
}

model notification_preferences {
  preference_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  category      String    @db.VarChar(50)
  enabled       Boolean   @default(true)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  modified_at   DateTime? @updatedAt @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, category])
  @@index([user_id])
  @@index([category, enabled], map: "idx_notification_preferences_category_enabled")
}

model notification_logs {
  log_id        Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  body          String
  type          String   @db.VarChar(50)
  target_type   String   @db.VarChar(50)
  target_id     String?  @db.VarChar(255)
  sent_by       String?  @db.Uuid
  source        String?  @db.VarChar(100)
  tokens_sent   Int      @default(0)
  tokens_failed Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz()

  users      users?                    @relation("notification_logs_sender", fields: [sent_by], references: [user_id])
  deliveries notification_deliveries[]

  @@index([sent_by], map: "idx_notification_logs_sender")
  @@index([created_at], map: "idx_notification_logs_created")
  @@index([source], map: "idx_notification_logs_source")
  @@index([target_type, target_id], map: "idx_notification_logs_target")
}

model notification_deliveries {
  delivery_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  log_id      Int
  user_id     String    @db.Uuid
  read_at     DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  notification_log notification_logs @relation(fields: [log_id], references: [log_id], onDelete: Cascade)
  user             users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([log_id, user_id])
  @@index([user_id, read_at])
  @@index([user_id, created_at(sort: Desc)])
  // NOTE: A partial index `idx_notification_deliveries_user_unread` on
  // (user_id, created_at DESC) WHERE read_at IS NULL exists in the database
  // (migration 20260423155416_notification_deliveries_unread_index).
  // Prisma does not support WHERE clauses in @@index, so it is managed
  // manually via raw SQL and applied via psql to each branch.
  @@map("notification_deliveries")
}

model user_fcm_tokens {
  fcm_token_id String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  user_id      String   @db.Uuid
  token        String   @unique @db.VarChar(255)
  device_type  String?  @db.VarChar(50)
  device_name  String?  @db.VarChar(100)
  active       Boolean  @default(true)
  last_used    DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  modified_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([active], map: "idx_user_fcm_tokens_active")
  @@index([user_id], map: "idx_user_fcm_tokens_user_id")
  @@map("user_fcm_tokens")
}

/**
 * Audit log for account self-deletion requests.
 * Required for Apple App Store guideline 5.1.1(v) compliance and GDPR audit trail.
 * Note: user_id is stored as a plain VarChar (not FK) because the users row
 * will be soft-deleted/anonymized — a FK with Cascade would delete this record,
 * defeating the audit purpose.
 */
model account_deletion_log {
  deletion_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  requested_at DateTime  @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  ip_address   String?   @db.VarChar(45)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_account_deletion_log_user_id")
  @@index([created_at], map: "idx_account_deletion_log_created_at")
  @@map("account_deletion_log")
}

/**
 * GDPR "Download My Data" — tracks export request lifecycle.
 * status flow: pending → processing → ready | failed
 * ready rows expire after 48h (expires_at). Cleanup cron marks them 'expired'
 * and deletes the R2 object. Expired rows are soft-deleted after 6 months.
 */
model data_export_requests {
  export_id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  status             String    @default("pending") @db.VarChar(16)
  format             String    @default("json") @db.VarChar(16)
  r2_key             String?   @db.VarChar(512)
  file_size_bytes    BigInt?
  sha256_checksum    String?   @db.VarChar(64)
  failure_reason     String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  started_at         DateTime? @db.Timestamptz(6)
  completed_at       DateTime? @db.Timestamptz(6)
  expires_at         DateTime? @db.Timestamptz(6)
  downloaded_count   Int       @default(0)
  last_downloaded_at DateTime? @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_data_export_requests_user_created")
  @@map("data_export_requests")
}

/// Reportes de Soporte/Ayuda enviados desde la app móvil.
/// Creados vía POST /api/v1/support/reports. No se eliminan automáticamente:
/// triage se hace mediante `status` (open -> in_progress -> resolved -> closed).
model support_reports {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  category     String   @db.VarChar(32)
  title        String   @db.VarChar(120)
  description  String   @db.Text
  device_info  Json
  user_context Json?
  status       String   @default("open") @db.VarChar(16)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "idx_support_reports_user_id")
  @@index([status, created_at], map: "idx_support_reports_status_created")
  @@map("support_reports")
}

