  director             users?                 @relation("enrollment_director", fields: [director_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  secretary            users?                 @relation("enrollment_secretary", fields: [secretary_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  treasurer            users?                 @relation("enrollment_treasurer", fields: [treasurer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  secretary_treasurer  users?                 @relation("enrollment_secretary_treasurer", fields: [secretary_treasurer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
