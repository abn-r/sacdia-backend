enum director_succession_status_enum {
  scheduled
  activated
  blocked
  cancelled
}

model director_succession_plans {
  succession_id                 String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  club_section_id               Int
  outgoing_assignment_id        String                           @db.Uuid
  successor_user_id             String                           @db.Uuid
  target_ecclesiastical_year_id Int
  effective_date                DateTime                         @db.Date
  status                        director_succession_status_enum @default(scheduled)
  scheduled_by_id               String                           @db.Uuid
  scheduled_by_role             String                           @db.VarChar(64)
  scheduled_local_field_id      Int
  scheduled_at                  DateTime                         @default(now()) @db.Timestamptz(6)
  idempotency_key               String                           @db.VarChar(128)
  request_hash                  String                           @db.Char(64)
  activated_assignment_id       String?                          @unique @db.Uuid
  activated_at                  DateTime?                        @db.Timestamptz(6)
  blocked_at                    DateTime?                        @db.Timestamptz(6)
  block_code                    String?                          @db.VarChar(96)
  processing_token              String?                          @db.Uuid
  processing_expires_at         DateTime?                        @db.Timestamptz(6)
  attempt_count                 Int                              @default(0)
  last_attempt_at               DateTime?                        @db.Timestamptz(6)
  version                       Int                              @default(1)
  created_at                    DateTime                         @default(now()) @db.Timestamptz(6)
  modified_at                   DateTime                         @default(now()) @updatedAt @db.Timestamptz(6)
  club_section                  club_sections                    @relation(fields: [club_section_id], references: [club_section_id], onDelete: Restrict, onUpdate: NoAction)
  outgoing_assignment           club_role_assignments            @relation("director_succession_outgoing_assignment", fields: [outgoing_assignment_id], references: [assignment_id], onDelete: Restrict, onUpdate: NoAction)
  activated_assignment          club_role_assignments?           @relation("director_succession_activated_assignment", fields: [activated_assignment_id], references: [assignment_id], onDelete: Restrict, onUpdate: NoAction)
  successor                     users                            @relation("director_succession_successor", fields: [successor_user_id], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  target_ecclesiastical_year    ecclesiastical_years              @relation(fields: [target_ecclesiastical_year_id], references: [year_id], onDelete: Restrict, onUpdate: NoAction)
  scheduled_by                  users                            @relation("director_succession_scheduler", fields: [scheduled_by_id], references: [user_id], onDelete: Restrict, onUpdate: NoAction)
  scheduled_local_field         local_fields                     @relation(fields: [scheduled_local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([club_section_id, target_ecclesiastical_year_id])
  @@unique([scheduled_by_id, idempotency_key])
  @@index([status, effective_date, processing_expires_at])
  @@index([successor_user_id])
  @@index([outgoing_assignment_id])
  @@index([scheduled_local_field_id])
}

