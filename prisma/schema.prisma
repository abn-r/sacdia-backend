  modified_at                                 DateTime @default(now()) @db.Timestamptz(6)

  schedule_block camporee_event_schedule_blocks @relation(fields: [schedule_block_id], references: [camporee_event_schedule_block_id], onDelete: Cascade, onUpdate: NoAction)
  camporee_club  camporee_clubs?                @relation(fields: [camporee_club_id], references: [camporee_club_id], onDelete: SetNull, onUpdate: NoAction)
  club_section   club_sections                  @relation(fields: [club_section_id], references: [club_section_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([schedule_block_id, active], map: "idx_camporee_schedule_block_assignments_block")
  @@index([club_section_id, active], map: "idx_camporee_schedule_block_assignments_section")
