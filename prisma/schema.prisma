  annual_ranking_config annual_ranking_configs             @relation(fields: [annual_ranking_config_id], references: [annual_ranking_config_id], onDelete: Cascade, onUpdate: NoAction)
  components            annual_ranking_component_configs[]

  @@unique([annual_ranking_config_id, axis_key], map: "annual_ranking_axis_configs_unique_axis")
  @@index([active, sort_order], map: "idx_annual_ranking_axis_configs_active_order")
  @@index([annual_ranking_config_id, active, sort_order], map: "idx_annual_ranking_axis_configs_config_active_order")
  @@map("annual_ranking_axis_configs")
}

model annual_ranking_component_configs {
  annual_ranking_component_config_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  annual_ranking_config_id           String   @db.Uuid
  annual_ranking_axis_config_id      String?  @db.Uuid
  component_key                      String   @db.VarChar(50)
  label                              String   @db.VarChar(120)
  max_points                         Int
  sort_order                         Int      @default(0)
  active                             Boolean  @default(true)
  created_at                         DateTime @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  annual_ranking_config      annual_ranking_configs       @relation(fields: [annual_ranking_config_id], references: [annual_ranking_config_id], onDelete: Cascade, onUpdate: NoAction)
  annual_ranking_axis_config annual_ranking_axis_configs? @relation(fields: [annual_ranking_axis_config_id], references: [annual_ranking_axis_config_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([annual_ranking_config_id, component_key], map: "annual_ranking_component_configs_unique_component")
  @@index([active, sort_order], map: "idx_annual_ranking_component_configs_active_order")
  @@index([annual_ranking_axis_config_id], map: "idx_annual_ranking_component_configs_axis_id")
  @@map("annual_ranking_component_configs")
}

model club_annual_rankings {
  ranking_id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  club_enrollment_id      String    @db.Uuid
  club_type_id            Int
  ecclesiastical_year_id  Int
  award_category_id       String    @default("00000000-0000-0000-0000-000000000000") @db.Uuid
  total_earned_points     Int       @default(0)
  total_max_points        Int       @default(0)
  progress_percentage     Float     @default(0)
  rank_position           Int?
  calculated_at           DateTime  @default(now()) @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  modified_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  folder_score_pct        Decimal   @default(0) @db.Decimal(5, 2)
  finance_score_pct       Decimal   @default(0) @db.Decimal(5, 2)
  camporee_score_pct      Decimal   @default(0) @db.Decimal(5, 2)
  evidence_score_pct      Decimal   @default(0) @db.Decimal(5, 2)
  composite_score_pct     Decimal   @default(0) @db.Decimal(5, 2)
  composite_calculated_at DateTime? @db.Timestamptz(6)
  hierarchy_context_id    String?   @db.Uuid

  club_enrollment     club_enrollments     @relation(fields: [club_enrollment_id], references: [club_enrollment_id], onDelete: NoAction, onUpdate: NoAction)
  club_type           club_types           @relation(fields: [club_type_id], references: [club_type_id], onDelete: NoAction, onUpdate: NoAction)
  ecclesiastical_year ecclesiastical_years @relation(fields: [ecclesiastical_year_id], references: [year_id], onDelete: NoAction, onUpdate: NoAction)
  award_category      award_categories     @relation(fields: [award_category_id], references: [award_category_id], onDelete: NoAction, onUpdate: NoAction)
  hierarchy_context   hierarchy_contexts?  @relation(fields: [hierarchy_context_id], references: [hierarchy_context_id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([club_enrollment_id, ecclesiastical_year_id, award_category_id])
  @@index([club_type_id], map: "idx_club_annual_rankings_club_type")
  @@index([ecclesiastical_year_id], map: "idx_club_annual_rankings_year")
  @@index([award_category_id], map: "idx_club_annual_rankings_category")
  @@index([rank_position], map: "idx_club_annual_rankings_rank")
  @@index([hierarchy_context_id], map: "idx_club_annual_rankings_hierarchy_context")
  @@index([ecclesiastical_year_id, composite_score_pct(sort: Desc)], map: "idx_rankings_composite")
  @@map("club_annual_rankings")
