model annual_ranking_configs {
  annual_ranking_config_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  union_id                 Int?
  local_field_id           Int?
  ecclesiastical_year_id   Int
  club_type_id             Int
  max_points               Int
  active                   Boolean  @default(true)
  created_by               String?  @db.Uuid
  updated_by               String?  @db.Uuid
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  union               unions?                            @relation(fields: [union_id], references: [union_id], onDelete: Restrict, onUpdate: NoAction)
  local_field         local_fields?                      @relation(fields: [local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  ecclesiastical_year ecclesiastical_years               @relation(fields: [ecclesiastical_year_id], references: [year_id], onDelete: Restrict, onUpdate: NoAction)
  club_type           club_types                         @relation(fields: [club_type_id], references: [club_type_id], onDelete: Restrict, onUpdate: NoAction)
  axes                annual_ranking_axis_configs[]
  components          annual_ranking_component_configs[]

  // Scope uniqueness and exactly-one scope are enforced in SQL because Prisma
  // cannot model partial unique indexes.
  // - annual_ranking_configs_exactly_one_scope_check
  // - annual_ranking_configs_unique_union_scope
  // - annual_ranking_configs_unique_local_field_scope
  @@index([union_id], map: "idx_annual_ranking_configs_union_id")
  @@index([local_field_id], map: "idx_annual_ranking_configs_local_field_id")
  @@index([ecclesiastical_year_id, club_type_id], map: "idx_annual_ranking_configs_year_type")
  @@index([active], map: "idx_annual_ranking_configs_active")
  @@map("annual_ranking_configs")
}

model annual_ranking_axis_configs {
