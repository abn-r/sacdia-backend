model camporee_event_templates {
  event_template_id     Int                  @id @default(autoincrement())
  scope                 String               @db.VarChar(20)
  union_id              Int?
  local_field_id        Int?
  event_type_id         Int
  title                 String               @db.VarChar(150)
  description           String?
  requirements          String?
  development           String?
  prerequisites         String?
  materials             String?
  auxiliaries           String?
  max_points            Int
  scoring_enabled       Boolean  @default(false)
  min_points            Int                  @default(0)
  penalties             Json                 @default("[]")
  participants_mode     String               @db.VarChar(20)
  participants_count    Int?
  participants_by_class Json?
  duration_seconds      Int?
  active                Boolean              @default(true)
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  modified_at           DateTime             @default(now()) @db.Timestamptz(6)
  created_by            String?              @db.Uuid
  modified_by           String?              @db.Uuid
  event_type            camporee_event_types @relation(fields: [event_type_id], references: [event_type_id], onDelete: Restrict, onUpdate: NoAction)
  union                 unions?              @relation(fields: [union_id], references: [union_id], onDelete: Restrict, onUpdate: NoAction)
  local_field           local_fields?        @relation(fields: [local_field_id], references: [local_field_id], onDelete: Restrict, onUpdate: NoAction)
  creator               users?               @relation("camporee_event_template_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier              users?               @relation("camporee_event_template_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  rubrics               camporee_event_template_rubrics[]
  events                camporee_events[]

  @@index([scope, union_id], map: "idx_camporee_event_templates_scope_union")
  @@index([scope, local_field_id], map: "idx_camporee_event_templates_scope_lf")
  @@index([event_type_id], map: "idx_camporee_event_templates_event_type")
  @@index([active], map: "idx_camporee_event_templates_active")
}

model camporee_event_template_rubrics {
  camporee_event_template_rubric_id Int      @id @default(autoincrement())
  event_template_id                 Int
  title                             String   @db.VarChar(120)
  description                       String?
  max_points                        Decimal  @db.Decimal(10, 2)
  display_order                     Int      @default(0)
  active                            Boolean  @default(true)
  created_by                        String?  @db.Uuid
  modified_by                       String?  @db.Uuid
  created_at                        DateTime @default(now()) @db.Timestamptz(6)
  modified_at                       DateTime @default(now()) @db.Timestamptz(6)

  event_template camporee_event_templates @relation(fields: [event_template_id], references: [event_template_id], onDelete: Cascade, onUpdate: NoAction)
  creator        users?                   @relation("camporee_event_template_rubric_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier       users?                   @relation("camporee_event_template_rubric_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)

  @@index([event_template_id, active, display_order], map: "idx_camporee_event_template_rubrics_template_active")
}

model camporee_events {
  camporee_event_id     Int      @id @default(autoincrement())
  local_camporee_id     Int?
  union_camporee_id     Int?
  event_template_id     Int?
  event_type_id         Int
  title                 String   @db.VarChar(150)
  description           String?
  requirements          String?
  development           String?
  prerequisites         String?
  materials             String?
  auxiliaries           String?
  max_points            Int
  scoring_enabled       Boolean  @default(false)
  min_points            Int      @default(0)
  penalties             Json     @default("[]")
  participants_mode     String   @db.VarChar(20)
  participants_count    Int?
  participants_by_class Json?
  duration_seconds      Int?
  display_order         Int      @default(0)
  active                Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  modified_at           DateTime @default(now()) @db.Timestamptz(6)
  created_by            String?  @db.Uuid
  modified_by           String?  @db.Uuid

  // Agenda fields (camporee-agenda-events)
  day_number           Int                 @default(1)
  starts_at            String?             @db.VarChar(5)
  ends_at              String?             @db.VarChar(5)
  venue_id             Int?
  leader_user_id       String?             @db.Uuid
  leader_name_override String?             @db.VarChar(100)
  leader_role          String?             @db.VarChar(100)
  sections             String[]            @default([])
  display_category     String              @default("logistico") @db.VarChar(40)
  status               CamporeeEventStatus @default(programado)
  capacity             Int?
  registered_count     Int                 @default(0)

  event_type     camporee_event_types      @relation(fields: [event_type_id], references: [event_type_id], onDelete: Restrict, onUpdate: NoAction)
  event_template camporee_event_templates? @relation(fields: [event_template_id], references: [event_template_id], onDelete: SetNull, onUpdate: NoAction)
  local_camporee local_camporees?          @relation(fields: [local_camporee_id], references: [local_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  union_camporee union_camporees?          @relation(fields: [union_camporee_id], references: [union_camporee_id], onDelete: Cascade, onUpdate: NoAction)
  creator        users?                    @relation("camporee_event_creator", fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  modifier       users?                    @relation("camporee_event_modifier", fields: [modified_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  venue          camporee_venues?          @relation(fields: [venue_id], references: [camporee_venue_id], onDelete: SetNull, onUpdate: NoAction)
  leader         users?                    @relation("camporee_event_leader", fields: [leader_user_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction)
  rubrics               camporee_event_rubrics[]
  judge_assignments     camporee_event_judge_assignments[]
  score_submissions     camporee_event_score_submissions[]
  score_section_results camporee_event_section_results[]
  schedule_blocks       camporee_event_schedule_blocks[]
  staff_assignments     camporee_event_staff_assignments[]
  @@index([local_camporee_id], map: "idx_camporee_events_local_camporee")
  @@index([union_camporee_id], map: "idx_camporee_events_union_camporee")
  @@index([event_template_id], map: "idx_camporee_events_template")
  @@index([active], map: "idx_camporee_events_active")
  @@index([local_camporee_id, display_order], map: "idx_camporee_events_display_order")
  @@index([day_number, active], map: "camporee_events_day_idx")
  @@index([status, active], map: "camporee_events_status_idx")
  @@index([display_category, active], map: "camporee_events_category_idx")
  @@index([venue_id], map: "camporee_events_venue_idx")
  @@index([leader_user_id], map: "camporee_events_leader_idx")

}

