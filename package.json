  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:spec": "npx ts-node scripts/generate-openapi.ts",
    "load-test": "node scripts/load-test.js",
    "verify:fcm-migration": "npx tsx scripts/verify-fcm-migration.ts",
    "import:legacy-catalogs": "npx ts-node scripts/import-legacy-catalogs.ts",
    "migrate:storage-urls:r2": "npx tsx scripts/migrate-storage-urls-to-r2.ts",
    "audit:security": "pnpm audit --audit-level=high"
  },
