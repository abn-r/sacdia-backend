    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^better-auth$": "<rootDir>/../test/mocks/better-auth.mock.ts",
      "^better-auth/(.*)$": "<rootDir>/../test/mocks/better-auth.mock.ts",
      "^#async_hooks$": "<rootDir>/../test/mocks/async-hooks.mock.ts"
    }
  }
