    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "react-email": "^3.0.0",
    "source-map-support": "^0.5.21",
