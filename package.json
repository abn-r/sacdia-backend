{
  "name": "sacdia-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:spec": "npx ts-node scripts/generate-openapi.ts",
    "load-test": "node scripts/load-test.js",
    "verify:fcm-migration": "npx tsx scripts/verify-fcm-migration.ts",
    "verify:iana-timezones": "bash scripts/verify-iana-timezone-release.sh",
    "verify:institutional-hierarchy-migration": "tsx scripts/verify-institutional-hierarchy-migration.ts",
    "verify:authorization-p0": "exec scripts/verify-authorization-p0.ts",
    "audit:master-honor-assignments": "tsx scripts/audit-master-honor-assignments.ts",
    "import:master-honor-rules": "tsx scripts/import-master-honor-rules.ts",
    "prisma:seed:core": "tsx prisma/seeds/core.ts",
    "import:legacy-catalogs": "npx ts-node scripts/import-legacy-catalogs.ts",
    "migrate:storage-urls:r2": "npx tsx scripts/migrate-storage-urls-to-r2.ts",
    "audit:security": "pnpm audit --audit-level=high",
    "benchmark:smoke": "node scripts/benchmark-api.js --profile smoke",
    "benchmark:baseline": "node scripts/benchmark-api.js --profile baseline",
    "benchmark:stress": "node scripts/benchmark-api.js --profile stress",
    "benchmark:spike": "node scripts/benchmark-api.js --profile spike",
    "benchmark:self-test": "node --test scripts/benchmark-api.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/s3-request-presigner": "^3.1100.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nestjs": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.25",
    "bullmq": "^5.81.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "multer": "^2.2.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^4.6.1",
    "otplib": "^13.4.1",
    "p-limit": "^5.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "react-email": "^6.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.{js,jsx,ts,tsx}"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "**/config/throttler.config.ts": {
        "branches": 70,
        "functions": 75,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [],
    "moduleNameMapper": {
      "^better-auth$": "<rootDir>/../test/mocks/better-auth.mock.ts",
      "^better-auth/(.*)$": "<rootDir>/../test/mocks/better-auth.mock.ts",
      "^#async_hooks$": "<rootDir>/../test/mocks/async-hooks.mock.ts"
    }
  }
}
