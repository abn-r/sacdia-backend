{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/.pnpm/(?!(jose@|jwks-rsa@|@scure\\+base@|@otplib\\+|otplib@|@noble\\+hashes@|@noble\\+ciphers@|p-limit@|yocto-queue@))"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^better-auth$": "<rootDir>/mocks/better-auth.mock.ts",
    "^better-auth/(.*)$": "<rootDir>/mocks/better-auth.mock.ts",
    "^#async_hooks$": "<rootDir>/mocks/async-hooks.mock.ts"
  },
  "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
  "testTimeout": 30000,
  "verbose": true
}
