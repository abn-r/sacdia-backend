{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/.pnpm/(?!(jose@|jwks-rsa@|@scure\\+base@|@otplib\\+|otplib@|@noble\\+hashes@|@noble\\+ciphers@))"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^better-auth$": "<rootDir>/mocks/better-auth.mock.ts",
    "^better-auth/(.*)$": "<rootDir>/mocks/better-auth.mock.ts"
  },
  "setupFilesAfterEnv": ["<rootDir>/setup.ts"],
  "testTimeout": 30000,
  "verbose": true
}
