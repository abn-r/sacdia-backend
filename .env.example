# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Supabase (obtener de tu proyecto en Supabase Dashboard)
SUPABASE_URL = 'https://***REMOVED_PROJECT_REF***.supabase.co'
SUPABASE_ANON_KEY = '***REMOVED_ANON_KEY***'
SUPABASE_SERVICE_ROLE_KEY = '***REMOVED_SERVICE_ROLE_KEY***'
SUPABASE_JWT_SECRET = '***REMOVED_JWT_SECRET***'

# Cloudflare R2 (Storage de archivos)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_REGION="auto"
R2_SIGNED_URL_EXPIRES_SECONDS="300"

# Buckets privados (se entregan con URL firmada desde backend)
# R2_PUBLIC_URL_* privado puede ser el S3 API base:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
R2_BUCKET_USER_PROFILES="user-profiles"
R2_PUBLIC_URL_USER_PROFILES="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/user-profiles"
R2_KEY_PREFIX_USER_PROFILES=""

R2_BUCKET_USERS_HONORS="secure-documents"
R2_PUBLIC_URL_USERS_HONORS="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/secure-documents/users_honors"
R2_KEY_PREFIX_USERS_HONORS="users_honors"

R2_BUCKET_USERS_HONORS_CERT="secure-documents"
R2_PUBLIC_URL_USERS_HONORS_CERT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/secure-documents/users_honors_cert"
R2_KEY_PREFIX_USERS_HONORS_CERT="users_honors_cert"

R2_BUCKET_ACTIVITIES_IMAGES="secure-documents"
R2_PUBLIC_URL_ACTIVITIES_IMAGES="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com/secure-documents/activities"
R2_KEY_PREFIX_ACTIVITIES_IMAGES="activities"

# Buckets públicos (servir desde r2.dev/custom domain)
R2_BUCKET_HONORS_IMAGES="static-assets"
R2_PUBLIC_URL_HONORS_IMAGES="https://pub-c8aa231ae66c46ff96fc5e811994d9d2.r2.dev/honors"
R2_KEY_PREFIX_HONORS_IMAGES="honors"

R2_BUCKET_HONORS_PDF="static-assets"
R2_PUBLIC_URL_HONORS_PDF="https://pub-c8aa231ae66c46ff96fc5e811994d9d2.r2.dev/honors_pdf"
R2_KEY_PREFIX_HONORS_PDF="honors_pdf"

R2_BUCKET_CLASSES_DOCUMENTS="static-assets"
R2_PUBLIC_URL_CLASSES_DOCUMENTS="https://pub-c8aa231ae66c46ff96fc5e811994d9d2.r2.dev/classes"
R2_KEY_PREFIX_CLASSES_DOCUMENTS="classes"

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
# true => formato legible en consola (dev). En producción dejar false.
LOG_PRETTY=true
# Campos ocultos en consola pretty para reducir ruido
LOG_PRETTY_IGNORE="pid,hostname,req,res,responseTime"
FRONTEND_URL="http://localhost:3001"
# Ventana temporal de compatibilidad legacy (2026-03-04 a 2026-03-18)
AUTH_REJECT_SNAKE_CASE=false

# JWT (ya no es necesario, usamos el de Supabase)
# JWT_SECRET="your-jwt-secret-change-this"
# JWT_EXPIRATION="7d"

# Redis (cache distribuido y sesiones)
# Local:
REDIS_URL="redis://localhost:6379"
# Upstash (ejemplo):
# REDIS_URL="redis://default:YOUR_PASSWORD@YOUR_REGION.upstash.io:YOUR_PORT"

# Firebase Admin SDK (FCM push notifications)
# Opción recomendada: JSON del service account en Base64 (evita errores de PEM)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=""
# Opción alternativa: JSON plano (escapeado)
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Opción legacy: usar campos separados
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Sentry Monitoring (para tracking de errores)
SENTRY_DSN="https://YOUR_PUBLIC_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID"
