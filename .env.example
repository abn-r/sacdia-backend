# =============================================================================
# SACDIA Backend — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in real values.
# Keys marked  # <SECRET>  must NEVER be committed to version control.
#
# Source of truth for all env var names used by the application.
# Validated at startup via src/config/env.validation.ts (Joi schema).
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

NODE_ENV=development
# Valid values: development | production | test

PORT=3000
# HTTP port the NestJS server listens on (default: 3000)

FRONTEND_URL=https://app.sacdia.app
# Full origin of the admin/app frontend — used for OAuth redirect and
# password-reset email links. Must match the origin configured in Better Auth.

ALLOWED_ORIGINS=https://app.sacdia.app,https://admin.sacdia.app
# Comma-separated list of origins allowed by the CORS middleware.
# In development, localhost origins are added automatically.

ALLOWED_OAUTH_REDIRECT_URLS=https://app.sacdia.app/auth/callback,sacdia://auth/callback
# Comma-separated OAuth redirect allowlist. Falls back to ALLOWED_ORIGINS when unset.

AUTH_REJECT_SNAKE_CASE=false
# Set to true to reject requests with snake_case JWT subject fields (strict mode).

SWAGGER_ENABLED=true
# Enable the Swagger UI at /api. Recommended false in production.

REQUEST_TIMEOUT_MS=30000
# Global HTTP timeout in milliseconds (default: 30 000 ms).

BOOTSTRAP_SECRET=<32-char-random-hex-min>  # <SECRET>
# One-time admin bootstrap secret. Used by POST /api/v1/admin/rbac/bootstrap-admin.
# If unset, that endpoint returns 403 (disabled). Remove or unset after bootstrapping.


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

LOG_LEVEL=debug
# Valid values: debug | info | warn | error

LOG_PRETTY=true
# Set to true to enable Pino pretty-print (recommended for development only).

LOG_PRETTY_IGNORE=req,res
# Comma-separated list of Pino log fields to suppress in pretty-print output.


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL via Neon. Use the pooled connection string for the app and the
# direct (non-pooled) URL for migrations and the Prisma shadow database.
# See docs: https://neon.tech/docs/connect/connection-pooling

DATABASE_URL=postgresql://user:pass@host.neon.tech/sacdia?sslmode=require  # <SECRET>
# Pooled connection string — used by the NestJS app (PrismaService).

DATABASE_DIRECT_URL=postgresql://user:pass@host.neon.tech/sacdia?sslmode=require  # <SECRET>
# Non-pooled direct URL — required for prisma migrate commands.
# Set in prisma.config.ts via the directUrl field.

PRISMA_POOL_CONNECTION_TIMEOUT_MS=15000
# Optional pg pool connection timeout for PrismaService. Keep 15000ms in dev
# when Neon free-tier/serverless compute may cold-start after suspend.


# -----------------------------------------------------------------------------
# AUTHENTICATION — Better Auth (HS256 JWT)
# -----------------------------------------------------------------------------
# Self-hosted at src/better-auth/. Option C architecture: Better Auth handles
# auth sessions; SACDIA signs its own JWT using BETTER_AUTH_SECRET.

BETTER_AUTH_SECRET=<32-char-random-hex>  # <SECRET>
# Master secret shared by Better Auth, the NestJS JWT strategy, and QR token
# signing. QrModule registers its own JwtModule using this secret (HS256) —
# there is NO separate QR_HMAC_SECRET.
# Must be at least 32 characters. Generate with: openssl rand -hex 32

BETTER_AUTH_BASE_URL=http://localhost:3000
# Base URL for Better Auth internal callbacks (usually the backend URL).

EMAIL_ENABLED=false
# Set to true to enable transactional email sending via Resend.
# Defaults to false (fail-safe: emails off unless explicitly enabled).


# -----------------------------------------------------------------------------
# OAUTH PROVIDERS — Google
# -----------------------------------------------------------------------------

GOOGLE_CLIENT_ID=<google-oauth-client-id>  # <SECRET>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>  # <SECRET>


# -----------------------------------------------------------------------------
# OAUTH PROVIDERS — Apple Sign In
# -----------------------------------------------------------------------------

APPLE_CLIENT_ID=com.example.sacdia
# Apple Services ID (not the bundle ID).

APPLE_TEAM_ID=<10-char-apple-team-id>

APPLE_KEY_ID=<10-char-apple-key-id>

APPLE_PRIVATE_KEY=<apple-private-key-pem-contents>  # <SECRET>
# PEM-encoded private key from Apple Developer portal (.p8 file contents).
# Store as a single-line string with \n for newlines, or use a secrets manager.


# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Redis URL — BullMQ queues + cache catalogos (cache-aside catálogos, TTL 1h / 24h)
#
# Local dev:    redis://localhost:6379
#               Opciones: Redis nativo (`brew services start redis`) o Docker Compose:
#               `docker compose up -d redis` (servicio sacdia-redis en docker-compose.yml).
#
# Staging/Prod: rediss://default:<PASSWORD>@<HOST>:<PORT>/0
#               Upstash con TLS. Cada entorno (staging vs prod) DEBE tener su propia
#               base Upstash — no compartir credenciales entre staging y prod o se
#               duplica el burn de comandos.
#
# El backend desactiva BullMQ y la cache si REDIS_URL está vacía o contiene placeholders
# (YOUR_PASSWORD, YOUR_REGION, YOUR_PORT). Ver src/config/bullmq.config.ts.
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# CLOUDFLARE R2 — Credentials
# -----------------------------------------------------------------------------

R2_ACCOUNT_ID=<cloudflare-account-id>
# Found in the Cloudflare dashboard (right-side panel on the home page).

R2_ACCESS_KEY_ID=<r2-access-key-id>  # <SECRET>
# R2 API token — Access Key ID.

R2_SECRET_ACCESS_KEY=<r2-secret-access-key>  # <SECRET>
# R2 API token — Secret Access Key.

R2_REGION=auto
# R2 does not use AWS regions. Leave as "auto".

R2_SIGNED_URL_EXPIRES_SECONDS=300
# Default presigned URL TTL in seconds (default: 300 = 5 min).


# -----------------------------------------------------------------------------
# CLOUDFLARE R2 — Buckets
# -----------------------------------------------------------------------------
# Each bucket alias requires three env vars:
#   R2_BUCKET_*         — actual R2 bucket name in Cloudflare
#   R2_PUBLIC_URL_*     — public CDN base URL (see section below)
#   R2_KEY_PREFIX_*     — key prefix segment stored with every object key
#
# Buckets marked "public" serve objects directly via CDN URL.
# Private buckets serve objects via presigned S3 URLs only.

# User profile avatars (public)
R2_BUCKET_USER_PROFILES=sacdia-user-profiles
R2_KEY_PREFIX_USER_PROFILES=user-profiles

# Honor badge images (public)
R2_BUCKET_HONORS_IMAGES=sacdia-honors
R2_KEY_PREFIX_HONORS_IMAGES=honors

# Honor PDF documents (public)
R2_BUCKET_HONORS_PDF=sacdia-honors-pdf
R2_KEY_PREFIX_HONORS_PDF=honors_pdf

# Achievement badges (public)
R2_BUCKET_ACHIEVEMENTS_BADGES=sacdia-achievements
R2_KEY_PREFIX_ACHIEVEMENTS_BADGES=achievements/badges

# Class curriculum documents (public)
R2_BUCKET_CLASSES_DOCUMENTS=sacdia-classes
R2_KEY_PREFIX_CLASSES_DOCUMENTS=classes

# Activity images (private — presigned URLs)
R2_BUCKET_ACTIVITIES_IMAGES=sacdia-activities
R2_KEY_PREFIX_ACTIVITIES_IMAGES=activities

# User honor evidence uploads (private — presigned URLs)
R2_BUCKET_USERS_HONORS=sacdia-users-honors
R2_KEY_PREFIX_USERS_HONORS=users_honors

# Honor completion certificates (private — presigned URLs)
R2_BUCKET_USERS_HONORS_CERT=sacdia-users-honors-cert
R2_KEY_PREFIX_USERS_HONORS_CERT=users_honors_cert

# General evidence files — also used by CLASS_EVIDENCE alias (private — presigned URLs)
# CLASS_EVIDENCE shares this bucket but uses R2_KEY_PREFIX_CLASS_EVIDENCE as its namespace.
R2_BUCKET_EVIDENCE_FILES=sacdia-evidence
R2_KEY_PREFIX_EVIDENCE_FILES=
R2_KEY_PREFIX_CLASS_EVIDENCE=class-evidence

# Insurance evidence (private — presigned URLs)
# NOTE: INSURANCE_EVIDENCE has a known keyPrefix/URL mismatch anomaly.
# See docs/storage/r2-keyprefix-conventions.md section 1b before making this bucket public.
R2_BUCKET_INSURANCE_EVIDENCE=sacdia-insurance
R2_KEY_PREFIX_INSURANCE_EVIDENCE=public-files

# Resource files (private — presigned URLs)
R2_BUCKET_RESOURCES_FILES=sacdia-resources
R2_KEY_PREFIX_RESOURCES_FILES=resources

# GDPR data exports (private — presigned URLs only, never public)
R2_BUCKET_DATA_EXPORTS=sacdia-data-exports
R2_KEY_PREFIX_DATA_EXPORTS=data-exports


# -----------------------------------------------------------------------------
# CLOUDFLARE R2 — Public Base URLs
# -----------------------------------------------------------------------------
# Target state per docs/storage/r2-keyprefix-conventions.md:
# All R2_PUBLIC_URL_* should be BARE DOMAIN (no path tail, no trailing slash).
# The keyPrefix (R2_KEY_PREFIX_*) is appended by the upload service at runtime.
# Current state: USER_PROFILES and ACHIEVEMENTS_BADGES are already bare;
#   others (HONORS_IMAGES, HONORS_PDF, CLASSES_DOCUMENTS, ACTIVITIES_IMAGES,
#   USERS_HONORS, USERS_HONORS_CERT) still embed the prefix as a URL path segment.
# Migration plan: switch one bucket at a time to bare-domain, deploy, then verify.
# See docs/storage/r2-keyprefix-conventions.md section 4 for the full migration checklist.

R2_PUBLIC_URL_USER_PROFILES=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_HONORS_IMAGES=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_HONORS_PDF=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_ACHIEVEMENTS_BADGES=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_CLASSES_DOCUMENTS=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_ACTIVITIES_IMAGES=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_USERS_HONORS=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_USERS_HONORS_CERT=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_EVIDENCE_FILES=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_INSURANCE_EVIDENCE=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_RESOURCES_FILES=https://pub-<bucket-id>.r2.dev
R2_PUBLIC_URL_DATA_EXPORTS=https://pub-<bucket-id>.r2.dev


# -----------------------------------------------------------------------------
# FIREBASE / FCM
# -----------------------------------------------------------------------------
# Used for push notifications (Firebase Cloud Messaging).
# Provide EITHER the base64-encoded service account JSON (recommended for
# containerised environments) OR the three individual credential fields.

FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-service-account-json>  # <SECRET>
# Preferred: base64(cat service-account.json)
# Takes precedence over the individual fields below when set.

FIREBASE_SERVICE_ACCOUNT_JSON=<raw-service-account-json-as-single-line>  # <SECRET>
# Alternative: raw JSON string. Use base64 variant in production.

FIREBASE_PROJECT_ID=sacdia-app
# Firebase project ID (also present in the service account JSON).

FIREBASE_PRIVATE_KEY=<firebase-private-key-pem>  # <SECRET>
# Used only when FIREBASE_SERVICE_ACCOUNT_JSON(_BASE64) is not set.

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sacdia-app.iam.gserviceaccount.com  # <SECRET>
# Used only when FIREBASE_SERVICE_ACCOUNT_JSON(_BASE64) is not set.


# -----------------------------------------------------------------------------
# EMAIL — Resend
# -----------------------------------------------------------------------------
# Transactional email transport. Only active when EMAIL_ENABLED=true.
# Free tier: 3 000 emails/month, 100 emails/day (enforced via BullMQ queue).

RESEND_API_KEY=re_<api-key>  # <SECRET>
# Resend API key. Required when EMAIL_ENABLED=true.

RESEND_FROM_EMAIL=SACDIA <noreply@sacdia.app>
# Display name + sender address shown to recipients.

RESEND_REPLY_TO=hola@sacdia.app
# Reply-To header shown to recipients (optional).


# -----------------------------------------------------------------------------
# ERROR MONITORING — Sentry
# -----------------------------------------------------------------------------

SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Sentry Data Source Name. If unset, Sentry integration is disabled entirely.

SENTRY_RELEASE=<git-sha-or-semver>
# Optional release identifier sent to Sentry (auto-detected from RENDER_GIT_COMMIT
# when running on Render.com).


# -----------------------------------------------------------------------------
# RENDER.COM (CI/CD — set automatically by Render)
# -----------------------------------------------------------------------------

RENDER_GIT_COMMIT=<git-sha>
# Injected by Render.com at deploy time. Used as the Sentry release tag when
# SENTRY_RELEASE is not explicitly set. Do not set manually.


# -----------------------------------------------------------------------------
# SCRIPTS — One-shot maintenance scripts (scripts/*.ts)
# -----------------------------------------------------------------------------

# ALLOW_ORPHAN_CLEANUP_PROD: required to be set to "true" before
# scripts/cleanup-orphan-user-images.ts will run against the prod branch.
# Leave UNSET in production unless actively running the script manually.
# Set to "true" only for the duration of the cleanup run, then remove.
ALLOW_ORPHAN_CLEANUP_PROD=

# Materiales (Pedidos) — comprobantes de pago
R2_BUCKET_MATERIALES_COMPROBANTES=sacdia-materiales-comprobantes
R2_PUBLIC_URL_MATERIALES_COMPROBANTES=https://pub-<bucket-id>.r2.dev
# Optional, defaults to 'materiales/comprobantes':
# R2_KEY_PREFIX_MATERIALES_COMPROBANTES=materiales/comprobantes